{
  "name": "handson",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "up": "${COMPOSE:-podman compose} up -d --wait",
    "down": "${COMPOSE:-podman compose} down",
    "reset": "npm run down && npm run up",
    "setup": "bash scripts/setup.sh",
    "read-code": "bash scripts/read-code.sh",
    "login": "bash scripts/login.sh",
    "decode": "bash scripts/decode-jwt.sh",
    "verify": "bash scripts/verify-jwt.sh",
    "refresh": "bash scripts/refresh.sh",
    "start": "node server.mjs"
  }
}
