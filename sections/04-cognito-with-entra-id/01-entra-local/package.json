{
  "name": "04-01-entra-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "up": "${COMPOSE:-podman compose} up -d --wait",
    "down": "${COMPOSE:-podman compose} down",
    "endpoints": "bash scripts/show-endpoints.sh",
