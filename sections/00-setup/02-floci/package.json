{
  "name": "00-02-floci",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "floci:up": "${COMPOSE:-podman compose} up -d --wait",
    "floci:down": "${COMPOSE:-podman compose} down",
    "floci:reset": "${COMPOSE:-podman compose} down && ${COMPOSE:-podman compose} up -d --wait"
  }
}
