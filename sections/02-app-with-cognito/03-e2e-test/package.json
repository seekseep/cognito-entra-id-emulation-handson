{
  "name": "02-03-e2e-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "floci:up": "${COMPOSE:-podman compose} up -d --wait",
    "floci:down": "${COMPOSE:-podman compose} down",
    "floci:reset": "${COMPOSE:-podman compose} down && ${COMPOSE:-podman compose} up -d --wait",
    "setup": "bash scripts/setup-cognito.sh",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "make-admin": "bash scripts/make-admin.sh",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1168.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "jose": "^6.2.17",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
